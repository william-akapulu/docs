{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Akapulu Labs",
  "variables": {
    "app-url": "https://akapulu.com",
    "api-base-url": "https://akapulu.com/api"
  },
  "description": "Akapulu Labs is an AI research lab building live conversational avatars.",
  "markdown": {
    "instructions": [
      "Akapulu Labs builds live AI avatars for real-time video calls. The recommended build path is the Pipecat plugin pipecat-akapulu (AkapuluAvatar after assistant audio).",
      "Install with: uv add pipecat-akapulu (or pip install pipecat-akapulu). Create a private Daily room for the browser, your bot, and the avatar. Mint a meeting token for each. POST /api/live-sessions/ from the server with avatar_id, show_ai_label (boolean), room_url, and avatar_token. The response is session_id. Leave audio out and video out off. Keep AKAPULU_API_KEY on the server.",
      "For a quick try without a bot: a hosted link is a dashboard URL. Pick an avatar, enter a system prompt, toggle This is AI, save, open the link, click Start Call.",
      "Loading status is a server message with type status. Do not poll for it.",
      "Every avatar frame has an invisible mark. Verify an mp4 with POST /api/video-marks/ and POST /api/video-marks/<id>/read/.",
      "API errors include error_code. Branch on that field, not the English error string."
    ]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/quickstart"
    },
    {
      "source": "/blog",
      "destination": "https://blog.akapulu.com"
    },
    {
      "source": "/blog/welcome-to-the-akapulu-blog",
      "destination": "https://blog.akapulu.com/what-is-akapulu-labs"
    },
    {
      "source": "/blog/what-is-akapulu",
      "destination": "https://blog.akapulu.com/what-is-akapulu-labs"
    },
    {
      "source": "/blog/what-is-akapulu/what-is-akapulu",
      "destination": "https://blog.akapulu.com/what-is-akapulu-labs"
    }
  ],
  "colors": {
    "primary": "#2D5C70",
    "light": "#38BDF8",
    "dark": "#1E3F4D"
  },
  "favicon": "/logo/logo_no_words.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "quickstart",
              "guides/getting-started/how-akapulu-works",
              "agent-setup"
            ]
          },
          {
            "group": "Calls",
            "pages": [
              "guides/calls/your-bot",
              "guides/calls/hosted-links"
            ]
          },
          {
            "group": "Avatars",
            "pages": [
              "guides/avatars/avatar-catalog"
            ]
          },
          {
            "group": "Recordings",
            "pages": [
              "guides/video-marks/verify"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Live sessions",
            "pages": [
              "api-reference/live-sessions/create"
            ]
          },
          {
            "group": "Video marks",
            "pages": [
              "api-reference/video-marks/create",
              "api-reference/video-marks/read"
            ]
          }
        ]
      },
      {
        "tab": "Examples",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "examples/index"
            ]
          }
        ]
      },
      {
        "tab": "Blog",
        "href": "https://blog.akapulu.com"
      }
    ]
  },
  "logo": {
    "light": "/logo/logo_dark.png",
    "dark": "/logo/logo.png",
    "href": "https://akapulu.com"
  },
  "appearance": {
    "default": "dark"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@akapulu.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://akapulu.com/accounts/login/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "youtube": "https://www.youtube.com/@JamesAkapulu",
      "linkedin": "https://www.linkedin.com/company/akapulu-ai/"
    }
  }
}
